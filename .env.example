# ===================================================
# Video-summarization Environment Configuration
# Copy this file to .env and fill in your values
# ===================================================

# ==================== Frontend ====================
# Backend API URL for the React frontend
REACT_APP_API_URL=http://localhost:8000
# Your YouTube Data API v3 key (for video search)
REACT_APP_YOUTUBE_API_KEY=your_youtube_api_key_here

# ==================== App Settings ====================
DEBUG=True
SECRET_KEY=your_32_char_secret_key_change_in_production

# ==================== JWT ====================
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== MongoDB ====================
# Option 1: MongoDB Atlas (cloud) - recommended for production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Option 2: Local MongoDB (Docker or installed)
# MONGODB_URI=mongodb://localhost:27017/

# Database name
MONGODB_DATABASE=user-auth

# ==================== Email (Gmail SMTP) ====================
# For Gmail, use an App Password (not your regular password)
# Create one at: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ==================== Google Gemini AI ====================
# Required for rich AI summaries (chapters, quotes, takeaways)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VIDEO_MODEL=gemini-2.0-flash

# ==================== ElevenLabs API (Voiceover) ====================
# Optional - Edge TTS (free) is used as fallback if not set
# Sign up at https://elevenlabs.io/ to get your API key
ELEVEN_API_KEY=sk_your_api_key_here

# ==================== Demo/Dev Mode ====================
DEMO_MODE=0

# ==================== Video Cache Settings ====================
VIDEO_CACHE_ENABLED=1
VIDEO_CACHE_MAX_SIZE_GB=10
VIDEO_CACHE_MAX_AGE_DAYS=30
MAX_PARALLEL_DOWNLOADS=2
DOWNLOAD_RETRY_ATTEMPTS=3

# ==================== Cleanup Settings ====================
ENABLE_AUTO_CLEANUP=1
CLEANUP_INTERVAL_HOURS=1
TEMP_DIR_MAX_AGE_HOURS=24
TRANSCRIPTION_TEMP_MAX_AGE_HOURS=1

# ==================== Whisper/Transcription ====================
WHISPER_ALLOW_PARALLEL=0
WHISPER_MODEL=base

# ==================== Duration Profiles ====================
DEFAULT_DURATION_MINUTES=10
MIN_DURATION_MINUTES=5
MAX_DURATION_MINUTES=20

# ==================== External Tools (Optional) ====================
# FFMPEG_PATH=/usr/bin/ffmpeg
# YTDLP_PATH=/usr/bin/yt-dlp
