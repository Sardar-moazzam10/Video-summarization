# ===================================================
# VidFusion — copy this to .env and fill in values
# ===================================================

# App
APP_NAME=VidFusion
DEBUG=False
API_PREFIX=/api/v1
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=aivideosummerizer

# Email (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# YouTube Data API v3
REACT_APP_YOUTUBE_API_KEY=your-youtube-api-key

# Gemini AI (optional)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Frontend — set to your Railway public URL after first deploy
REACT_APP_API_URL=https://your-app.railway.app

# CORS — set to your Railway public URL after first deploy
ALLOWED_ORIGINS=["https://your-app.railway.app"]

# AI Models (do not change — matches Dockerfile)
SUMMARIZATION_MODEL=sshleifer/distilbart-cnn-12-6
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
WHISPER_MODEL=base

# Duration
DEFAULT_DURATION_MINUTES=10
MIN_DURATION_MINUTES=5
MAX_DURATION_MINUTES=20

# Cache
VIDEO_CACHE_ENABLED=True
TRANSCRIPT_CACHE_ENABLED=True
AUDIO_CACHE_ENABLED=True

# Downloads
MAX_PARALLEL_DOWNLOADS=2
DOWNLOAD_RETRY_ATTEMPTS=3
