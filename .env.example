# ===================================================
# VidFusion — copy this to .env and fill in values
# ===================================================

# App
APP_NAME=VidFusion
ENVIRONMENT=development
DEBUG=False
API_PREFIX=/api/v1
# Generate once with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses to start if this is missing/weak.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=aivideosummerizer

# Email (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# YouTube Data API v3
REACT_APP_YOUTUBE_API_KEY=your-youtube-api-key

# Gemini AI (optional)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Frontend — set to your Railway public URL after first deploy
REACT_APP_API_URL=https://your-app.railway.app

# CORS — set to your Railway public URL after first deploy
ALLOWED_ORIGINS=["https://your-app.railway.app"]

# AI Models (do not change — matches Dockerfile)
SUMMARIZATION_MODEL=sshleifer/distilbart-cnn-12-6
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
WHISPER_MODEL=base

# Duration
DEFAULT_DURATION_MINUTES=10
MIN_DURATION_MINUTES=5
MAX_DURATION_MINUTES=30

# ==================== SEMANTIC SEGMENT SELECTION ====================
# Coverage-aware pipeline: semantic segmentation -> concept extraction ->
# submodular budgeted selection. Set false to fall back to the legacy
# top-score clip scorer in segment_extractor.py.
ENABLE_SEMANTIC_SELECTION=true

# Concept extraction via Ollama.
# false by default: benchmarked at 179.7s for ONE 450-word chunk on this CPU
# (llama3.2:3b, almost all of it prompt evaluation), which makes the stage cost
# ~21 minutes on a 25-minute video before timing out and falling back anyway.
# The TF-IDF keyphrase fallback is instant and pulls real domain terms.
# Set true on a GPU machine for named, explained concepts.
ENABLE_CONCEPT_LLM=false
CONCEPT_CHUNK_TIMEOUT_SECONDS=45
CONCEPT_TOTAL_TIMEOUT_SECONDS=300
CONCEPT_TOP_K=25

# Bounds on a single "complete thought" clip, in seconds.
SEGMENT_MIN_SECONDS=20
SEGMENT_MAX_SECONDS=90

# ==================== SELECTION SCORING WEIGHTS ====================
# See backend/services/coverage_selector.py for the full scoring function.
SELECT_CONCEPT_WEIGHT=0.32
SELECT_SEMANTIC_WEIGHT=0.20
SELECT_COVERAGE_WEIGHT=0.28
SELECT_COHERENCE_WEIGHT=0.10
SELECT_REDUNDANCY_PENALTY=0.25
SELECT_DURATION_PENALTY=0.05
SELECT_MIN_BUDGET_FILL=0.90

# Cache
VIDEO_CACHE_ENABLED=True
TRANSCRIPT_CACHE_ENABLED=True
AUDIO_CACHE_ENABLED=True

# Downloads
MAX_PARALLEL_DOWNLOADS=2
DOWNLOAD_RETRY_ATTEMPTS=3
