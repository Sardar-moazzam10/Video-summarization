graph Collaboration {
  layout=neato;
  graph [fontname="Segoe UI", bgcolor="white", overlap=false, splines=line];
  node [fontname="Segoe UI", shape=box, style="rounded,filled", fillcolor="#eef5fd",
        color="#14315c", fontcolor="#14315c", fixedsize=true, width=1.9, height=0.65];
  edge [fontname="Segoe UI", fontsize=9, color="#33475b"];

  UserN   [pos="0,4!",    label="User"];
  SPA     [pos="3,4!",    label="React SPA"];
  Router  [pos="6,4!",    label="Merge Router"];
  Queue   [pos="9,4!",    label="Output Task\nQueue", fillcolor="#fff4e0", color="#8a5400"];

  Segmenter [pos="2,1.5!",  label="Semantic\nSegmenter"];
  Extractor [pos="5,1.5!",  label="Concept\nExtractor"];
  Selector  [pos="8,1.5!",  label="Coverage\nSelector", fillcolor="#fde3b8", color="#8a5400"];

  VWorker [pos="6.5,-1!", label="Video Worker"];
  TWorker [pos="9.5,-1!", label="Text Worker"];

  UserN   -- SPA     [label="1: submit videos\n+ duration"];
  SPA     -- Router  [label="2: POST /merge"];
  Router  -- Segmenter [label="3: run pipeline"];
  Segmenter -- Selector [label="4: segments"];
  Extractor -- Selector [label="5: concepts"];
  Selector -- Queue    [label="6: publish\nevidence manifest"];
  Queue -- VWorker [label="7: claim (video)"];
  Queue -- TWorker [label="8: claim (text)"];
  VWorker -- SPA [label="9: video_ready"];
  TWorker -- SPA [label="10: completed"];
}
